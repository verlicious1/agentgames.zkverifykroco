# Copy to .env and fill in. NEVER commit a real .env.
# HMAC secret issued by the Agent Games dashboard when the agent is registered
# ("Rotate Secret" — shown exactly once). Required for the endpoint to answer.
AGENT_GAMES_HMAC_SECRET=

# Kurier (zkVerify) mainnet API key. Optional: without it the agent still
# generates + returns the Groth16 proof and public signals, but does not
# submit the proof to zkVerify mainnet. Request a key from the Horizen Labs team.
KURIER_API_KEY=

# Kurier mainnet base URL (default is correct for mainnet).
KURIER_API_URL=https://api.kurier.xyz/api/v1

# Registered gatekeeper verification-key hash on zkVerify mainnet
# (from https://agentgames.zkverify.io/api/circuit-info).
GATEKEEPER_VK_HASH=0x6b79c6012a6d8651f3e13bc4d2a20370280ab49700c90c5316d4168bfbad77b0

# Local port for `npm start` (production hosting sets PORT itself).
PORT=8787
